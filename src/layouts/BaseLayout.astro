---
import { company, navLinks, seo } from "../data/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, image } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith("/") ? currentPath : `${currentPath}/`;
const pageSeo = seo.pages[normalizedPath as keyof typeof seo.pages];
const pageTitle = pageSeo?.title ?? `${title} | ${company.shortName}`;
const pageDescription = Astro.props.description ?? pageSeo?.description ?? company.description;
const configuredSiteUrl = import.meta.env.PUBLIC_SITE_URL;
const canonicalUrl = configuredSiteUrl ? new URL(normalizedPath, configuredSiteUrl).toString() : normalizedPath;
const ogImageUrl = configuredSiteUrl ? new URL(image ?? seo.defaultImage, configuredSiteUrl).toString() : image ?? seo.defaultImage;
const logoUrl = configuredSiteUrl
  ? new URL("/assets/branding/site-logo-transparent.png", configuredSiteUrl).toString()
  : "/assets/branding/site-logo-transparent.png";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: company.name,
    alternateName: company.shortName,
    url: configuredSiteUrl || "/",
    logo: logoUrl,
    email: company.email,
    address: {
      "@type": "PostalAddress",
      addressCountry: "CN",
      addressRegion: "北京市",
      addressLocality: "北京市东城区",
      streetAddress: company.address
    },
    description: company.description
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: company.shortName,
    url: configuredSiteUrl || "/",
    description: company.description
  }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={seo.keywords.join(",")} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={company.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="brand" href="/">
          <img class="brand-logo" src="/assets/branding/site-logo-transparent.png" alt={`${company.shortName} logo`} />
        </a>
        <nav class="site-nav" aria-label="主导航">
          {navLinks.map((link) => {
            const active =
              link.href === "/"
                ? currentPath === "/"
                : link.matchPrefixes
                  ? link.matchPrefixes.some((prefix) => currentPath.startsWith(prefix))
                  : currentPath === link.href || currentPath.startsWith(link.href);

            return (
              <a href={link.href} class:list={[active && "active"]}>
                {link.label}
              </a>
            );
          })}
        </nav>
        <a class="nav-cta" href="/about/#contact">商务咨询</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand-block">
          <div class="footer-brand-head">
            <div class="footer-brand-meta">
              <p class="footer-overline">AI SOLUTIONS</p>
              <h2>{company.name}</h2>
            </div>
          </div>
          <p class="footer-brand-title">{company.footerTitle}</p>
          <p class="footer-brand-copy">{company.footerDescription}</p>
        </div>
        <div class="footer-contact-block">
          <p class="footer-title">联系信息</p>
          <div class="footer-contact-list">
            <div class="footer-contact-item">
              <span>邮箱</span>
              <a href={`mailto:${company.email}`}>{company.email}</a>
            </div>
            <div class="footer-contact-item">
              <span>地址</span>
              <p>{company.address}</p>
            </div>
            <div class="footer-contact-item">
              <span>备案</span>
              <p class="footer-icp">{company.icp}</p>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
