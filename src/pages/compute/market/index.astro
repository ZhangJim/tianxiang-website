---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import ComputeTabs from "../../../components/ComputeTabs.astro";
import { marketFilters, marketItems } from "../../../data/compute";
---

<BaseLayout title="算力市场">
  <section class="page-section">
    <div class="shell">
      <ComputeTabs />
      <SectionTitle
        eyebrow="COMPUTE MARKET"
        title="按需选择算力配置，覆盖训练与推理场景"
        description="支持多种GPU配置与接入方式，适用于模型训练、推理服务与AI应用开发，满足不同阶段的算力需求。"
      />
      <div class="filter-bar">
        <div class="filter-row">
          <span>计费方式</span>
          {marketFilters.billing.map((item, index) => <b class:list={["chip", index === 0 && "active"]}>{item}</b>)}
        </div>
        <div class="filter-row">
          <span>选择地区</span>
          {marketFilters.regions.map((item, index) => <b class:list={["chip", index === 0 && "active"]}>{item}</b>)}
        </div>
        <div class="filter-row">
          <span>GPU 型号</span>
          {marketFilters.gpus.map((item, index) => <b class:list={["chip", index === 0 && "active"]}>{item}</b>)}
        </div>
        <div class="filter-row">
          <span>GPU 数量</span>
          {marketFilters.cardCounts.map((item, index) => <b class:list={["chip", index === 0 && "active"]}>{item}</b>)}
        </div>
      </div>

      <div class="list-stack">
        {marketItems.map((item) => (
          <article class="list-card">
            <p class="card-meta">{item.region}</p>
            <h3>{item.name}</h3>
            <div class="spec-grid">
              <div class="spec-item">
                <strong>每 GPU 配置</strong>
                <p>CPU {item.cpu}</p>
                <p>内存 {item.memory}</p>
              </div>
              <div class="spec-item">
                <strong>存储配置</strong>
                <p>{item.storage}</p>
              </div>
              <div class="spec-item">
                <strong>环境版本</strong>
                <p>CUDA ≤ {item.cuda}</p>
                <p>{item.stock}</p>
              </div>
            </div>
            <p>{item.note}</p>
            <div class="price-row">
              <div>
                <div class="price">{item.price}</div>
                <p>支持企业批量合作与专属报价</p>
              </div>
              <a class="button button-primary" href="/about/#contact">商务咨询</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
