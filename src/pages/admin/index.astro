---
import { isAdminRequest } from "../../lib/adminAuth";

export const prerender = false;

if (!isAdminRequest(Astro.request)) {
  return Astro.redirect("/admin/login/");
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>天翔睿翼后台</title>
    <style is:global>
      :root {
        color: #171717;
        background: #f4efe7;
        font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      .admin-shell {
        width: min(100% - 48px, 1380px);
        margin: 0 auto;
      }

      .admin-header {
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        background: rgba(244, 239, 231, 0.94);
        backdrop-filter: blur(16px);
      }

      .admin-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-top: 18px;
      }

      .admin-brand h1 {
        font-size: 26px;
      }

      .admin-brand p {
        margin-top: 4px;
        color: #68645f;
        font-size: 14px;
      }

      .admin-header-actions {
        display: flex;
        gap: 10px;
      }

      .admin-tabs {
        display: flex;
        gap: 10px;
        padding: 16px 0 14px;
        flex-wrap: wrap;
      }

      .admin-tab {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        padding: 0 20px;
        border: 1px solid #ded7ce;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        color: #171717;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.18s ease;
      }

      .admin-tab:hover {
        border-color: #d67433;
        color: #d67433;
      }

      .admin-tab.active {
        border-color: transparent;
        background: #d67433;
        color: #fff;
        box-shadow: 0 8px 26px rgba(214, 116, 51, 0.32);
      }

      .button,
      button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        border: 0;
        border-radius: 999px;
        background: #d67433;
        color: #fff;
        font: inherit;
        font-weight: 800;
        cursor: pointer;
      }

      .button.secondary,
      button.secondary {
        border: 1px solid #ded7ce;
        background: rgba(255, 255, 255, 0.72);
        color: #171717;
      }

      .button.danger,
      button.danger {
        background: #b63b2f;
      }

      button[disabled] {
        opacity: 0.45;
        cursor: not-allowed;
      }

      [hidden] {
        display: none !important;
      }

      .admin-main {
        display: grid;
        gap: 22px;
        padding: 28px 0 54px;
      }

      .admin-card {
        padding: 26px;
        border: 1px solid rgba(255, 255, 255, 0.76);
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.78);
        box-shadow: 0 24px 80px rgba(31, 24, 15, 0.09);
      }

      .tab-panel[hidden] {
        display: none;
      }

      .panel-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }

      .panel-title h2 {
        font-size: 22px;
      }

      .panel-title p {
        margin-top: 6px;
        color: #68645f;
      }

      .panel-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
      }

      .search-input,
      input,
      select,
      textarea {
        width: 100%;
        min-height: 42px;
        padding: 0 14px;
        border: 1px solid #ded7ce;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.88);
        color: #171717;
        font: inherit;
      }

      textarea {
        min-height: 92px;
        padding: 12px 14px;
        resize: vertical;
      }

      .search-input {
        max-width: 320px;
      }

      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 14px;
      }

      .table-wrap {
        width: 100%;
        max-height: 620px;
        overflow: auto;
        border: 1px solid #e6dccd;
        border-radius: 18px;
        background: #fffaf2;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        padding: 14px 14px;
        border-bottom: 1px solid #d8c9ae;
        background: #ece2cb;
        color: #6c5d49;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-align: left;
        white-space: nowrap;
      }

      tbody td {
        padding: 14px 14px;
        border-bottom: 1px solid #e2d6bd;
        border-right: 1px solid #ece1c9;
        vertical-align: middle;
        white-space: nowrap;
        font-size: 14.5px;
      }

      tbody td:last-child {
        border-right: 0;
      }

      thead th {
        border-right: 1px solid #ece1c9;
      }

      thead th:last-child {
        border-right: 0;
      }

      tbody tr:nth-child(odd) td {
        background: #fffaf2;
      }

      tbody tr:nth-child(even) td {
        background: #f5ecd9;
      }

      tbody tr:hover td {
        background: #fbe6cf;
      }

      tbody tr:last-child td {
        border-bottom: 0;
      }

      td.wrap {
        min-width: 240px;
        white-space: normal;
        line-height: 1.6;
      }

      td.actions {
        white-space: nowrap;
        min-width: 170px;
        text-align: left;
      }

      td.actions > button,
      td.actions .row-actions > button {
        display: inline-flex !important;
        vertical-align: middle;
        min-height: 32px;
        margin-right: 8px;
        padding: 0 14px;
        font-size: 13px;
        white-space: nowrap;
      }

      td.actions > button:last-child,
      td.actions .row-actions > button:last-child {
        margin-right: 0;
      }

      .row-actions {
        display: flex !important;
        flex-direction: row;
        flex-wrap: nowrap;
        gap: 8px;
        align-items: center;
        white-space: nowrap;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
      }

      .status-pill.covered {
        background: rgba(31, 95, 73, 0.14);
        color: #1f5f49;
      }

      .status-pill.consult {
        background: rgba(214, 116, 51, 0.18);
        color: #b6531f;
      }

      .status-pill.talking {
        background: rgba(120, 113, 108, 0.2);
        color: #58524d;
      }

      .status-pill.default {
        background: rgba(0, 0, 0, 0.06);
        color: #58524d;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
      }

      .form-grid label {
        display: grid;
        gap: 8px;
        font-weight: 800;
      }

      .form-grid label.full {
        grid-column: 1 / -1;
      }

      .form-actions,
      .import-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .status {
        min-height: 24px;
        margin-top: 8px;
        color: #1f5f49;
        font-weight: 800;
      }

      .muted {
        color: #68645f;
      }

      .pagination {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 16px;
        flex-wrap: wrap;
      }

      .pagination button {
        min-height: 36px;
        padding: 0 14px;
        border: 1px solid #ded7ce;
        background: rgba(255, 255, 255, 0.78);
        color: #171717;
        font-size: 14px;
        font-weight: 700;
      }

      .pagination button:hover:not([disabled]) {
        border-color: #d67433;
        color: #d67433;
      }

      .page-info {
        color: #68645f;
        font-size: 14px;
      }

      .page-info strong {
        color: #d67433;
        font-weight: 800;
      }

      @media (max-width: 900px) {
        .admin-shell {
          width: min(100% - 24px, 1380px);
        }

        .admin-header-inner,
        .panel-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .form-grid {
          grid-template-columns: 1fr;
        }

        .panel-actions {
          width: 100%;
        }

        .search-input {
          max-width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <header class="admin-header">
      <div class="admin-shell admin-header-inner">
        <div class="admin-brand">
          <h1>天翔睿翼后台</h1>
          <p>统一管理合作咨询线索与 AI 旅拍机点位数据</p>
        </div>
        <div class="admin-header-actions">
          <a class="button secondary" href="/" target="_blank" rel="noreferrer">打开官网</a>
          <button class="secondary" id="logout-button" type="button">退出登录</button>
        </div>
      </div>
      <nav class="admin-shell admin-tabs" aria-label="后台模块切换">
        <button class="admin-tab active" type="button" data-tab="leads">合作咨询</button>
        <button class="admin-tab" type="button" data-tab="locations">AI 旅拍机点位</button>
      </nav>
    </header>

    <main class="admin-shell admin-main">
      <section class="admin-card tab-panel" data-panel="leads">
        <div class="panel-head">
          <div class="panel-title">
            <h2>合作咨询</h2>
            <p>用户从官网表单提交的线索，仅支持查看与导出，不在后台修改。</p>
          </div>
          <div class="panel-actions">
            <input class="search-input" id="leads-search" type="search" placeholder="搜索姓名、公司、手机号或产品" />
            <a class="button" href="/api/admin/leads?download=1">导出 CSV</a>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>提交时间</th>
                <th>姓名</th>
                <th>公司</th>
                <th>手机号</th>
                <th>咨询产品</th>
                <th>来源 IP</th>
              </tr>
            </thead>
            <tbody id="leads-body">
              <tr><td colspan="6" class="muted">正在加载...</td></tr>
            </tbody>
          </table>
        </div>
        <div class="pagination" id="leads-pagination"></div>
      </section>

      <section class="admin-card tab-panel" data-panel="locations" hidden>
        <div class="panel-head">
          <div class="panel-title">
            <h2>AI 旅拍机点位</h2>
            <p>维护城市、点位、场景、状态与搜索关键词；保存时会自动备份原 CSV。</p>
          </div>
          <div class="panel-actions">
            <a class="button" href="/api/admin/locations?download=1">导出点位 CSV</a>
          </div>
        </div>

        <form id="location-form" class="form-grid">
          <input name="id" type="hidden" />
          <label>
            城市/省份
            <input name="city" required />
          </label>
          <label>
            点位名称
            <input name="spotName" required />
          </label>
          <label>
            场景类型
            <input name="sceneType" placeholder="文旅景区 / 商业空间" required />
          </label>
          <label>
            设备类型
            <input name="deviceType" placeholder="AI旅拍机" required />
          </label>
          <label>
            状态
            <select name="status" required>
              <option value="已覆盖">已覆盖</option>
              <option value="可咨询">可咨询</option>
              <option value="洽谈中">洽谈中</option>
            </select>
          </label>
          <label>
            关键词
            <input name="keywords" placeholder="多个关键词用空格分隔" />
          </label>
          <label class="full">
            说明
            <textarea name="description"></textarea>
          </label>
          <div class="form-actions">
            <button type="submit">保存点位</button>
            <button class="secondary" type="button" id="reset-location-form" hidden>取消修改</button>
          </div>
          <div class="status" id="location-message"></div>
        </form>

        <div class="toolbar">
          <input class="search-input" id="location-search" placeholder="搜索城市、点位或关键词" />
          <div class="import-actions">
            <input id="location-import-file" type="file" accept=".csv,text/csv" />
            <button class="secondary" type="button" id="append-import">追加导入</button>
            <button class="danger" type="button" id="replace-import">覆盖导入</button>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>城市/省份</th>
                <th>点位名称</th>
                <th>场景类型</th>
                <th>设备类型</th>
                <th>状态</th>
                <th>说明</th>
                <th>关键词</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="locations-body">
              <tr><td colspan="8" class="muted">正在加载...</td></tr>
            </tbody>
          </table>
        </div>
        <div class="pagination" id="locations-pagination"></div>
      </section>
    </main>

    <script is:inline>
      const PAGE_SIZE = 20;

      const leadsBody = document.querySelector("#leads-body");
      const leadsSearch = document.querySelector("#leads-search");
      const leadsPaginationEl = document.querySelector("#leads-pagination");

      const locationsBody = document.querySelector("#locations-body");
      const locationsPaginationEl = document.querySelector("#locations-pagination");
      const locationForm = document.querySelector("#location-form");
      const locationMessage = document.querySelector("#location-message");
      const locationSearch = document.querySelector("#location-search");
      const importFile = document.querySelector("#location-import-file");
      const resetLocationButton = document.querySelector("#reset-location-form");

      let allLeads = [];
      let leadsKeyword = "";
      let leadsPage = 1;

      let locations = [];
      let locationsPage = 1;

      const escapeHtml = (value) => String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

      function statusPill(status) {
        const text = String(status ?? "").trim();
        let cls = "default";
        if (text === "已覆盖") cls = "covered";
        else if (text === "可咨询") cls = "consult";
        else if (text === "洽谈中") cls = "talking";
        return `<span class="status-pill ${cls}">${escapeHtml(text || "未填写")}</span>`;
      }

      function setLocationMessage(message, isError = false) {
        locationMessage.textContent = message;
        locationMessage.style.color = isError ? "#b63b2f" : "#1f5f49";
      }

      async function readCsvImportFile(file) {
        const buffer = await file.arrayBuffer();
        const utf8Text = new TextDecoder("utf-8").decode(buffer);

        if (utf8Text.includes("城市") || utf8Text.includes("点位")) {
          return utf8Text;
        }

        try {
          return new TextDecoder("gb18030").decode(buffer);
        } catch {
          return utf8Text;
        }
      }

      async function api(path, options = {}) {
        const response = await fetch(path, {
          ...options,
          headers: {
            "Content-Type": "application/json",
            ...(options.headers || {})
          }
        });

        if (response.status === 401) {
          location.href = "/admin/login/";
          return;
        }

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(data.message || "操作失败");
        }

        return data;
      }

      function renderPagination(container, current, total, onChange) {
        if (total <= 1) {
          container.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <button type="button" data-action="first" ${current === 1 ? "disabled" : ""}>首页</button>
          <button type="button" data-action="prev" ${current === 1 ? "disabled" : ""}>上一页</button>
          <span class="page-info">第 <strong>${current}</strong> / ${total} 页</span>
          <button type="button" data-action="next" ${current === total ? "disabled" : ""}>下一页</button>
          <button type="button" data-action="last" ${current === total ? "disabled" : ""}>末页</button>
        `;

        const go = (page) => {
          if (page < 1 || page > total || page === current) return;
          onChange(page);
        };

        container.querySelector('[data-action="first"]').addEventListener("click", () => go(1));
        container.querySelector('[data-action="prev"]').addEventListener("click", () => go(current - 1));
        container.querySelector('[data-action="next"]').addEventListener("click", () => go(current + 1));
        container.querySelector('[data-action="last"]').addEventListener("click", () => go(total));
      }

      function renderLeads() {
        const keyword = leadsKeyword.trim().toLowerCase();
        const filtered = allLeads.filter((item) => {
          if (!keyword) return true;
          return [item.submittedAt, item.name, item.company, item.phone, item.product, item.ip]
            .some((v) => String(v ?? "").toLowerCase().includes(keyword));
        });

        if (!filtered.length) {
          leadsBody.innerHTML = '<tr><td colspan="6" class="muted">' + (keyword ? "没有匹配的咨询" : "暂无合作咨询") + '</td></tr>';
          leadsPaginationEl.innerHTML = "";
          return;
        }

        const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
        if (leadsPage > totalPages) leadsPage = totalPages;
        if (leadsPage < 1) leadsPage = 1;

        const start = (leadsPage - 1) * PAGE_SIZE;
        const pageItems = filtered.slice(start, start + PAGE_SIZE);

        leadsBody.innerHTML = pageItems.map((item) => `
          <tr>
            <td>${escapeHtml(item.submittedAt)}</td>
            <td>${escapeHtml(item.name)}</td>
            <td>${escapeHtml(item.company)}</td>
            <td>${escapeHtml(item.phone)}</td>
            <td>${escapeHtml(item.product)}</td>
            <td>${escapeHtml(item.ip)}</td>
          </tr>
        `).join("");

        renderPagination(leadsPaginationEl, leadsPage, totalPages, (page) => {
          leadsPage = page;
          renderLeads();
        });
      }

      function renderLocations() {
        const keyword = String(locationSearch.value || "").trim().toLowerCase();
        const filtered = locations.filter((item) => {
          const text = `${item.city} ${item.spotName} ${item.sceneType} ${item.deviceType} ${item.status} ${item.description} ${item.keywords}`.toLowerCase();
          return !keyword || text.includes(keyword);
        });

        if (!filtered.length) {
          locationsBody.innerHTML = '<tr><td colspan="8" class="muted">' + (keyword ? "没有匹配的点位" : "暂无点位数据") + '</td></tr>';
          locationsPaginationEl.innerHTML = "";
          return;
        }

        const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
        if (locationsPage > totalPages) locationsPage = totalPages;
        if (locationsPage < 1) locationsPage = 1;

        const start = (locationsPage - 1) * PAGE_SIZE;
        const pageItems = filtered.slice(start, start + PAGE_SIZE);

        locationsBody.innerHTML = pageItems.map((item) => `
          <tr>
            <td>${escapeHtml(item.city)}</td>
            <td>${escapeHtml(item.spotName)}</td>
            <td>${escapeHtml(item.sceneType)}</td>
            <td>${escapeHtml(item.deviceType)}</td>
            <td>${statusPill(item.status)}</td>
            <td class="wrap">${escapeHtml(item.description)}</td>
            <td class="wrap">${escapeHtml(item.keywords)}</td>
            <td class="actions">
              <div class="row-actions">
                <button class="secondary" type="button" data-edit="${item.id}">修改</button>
                <button class="danger" type="button" data-delete="${item.id}">删除</button>
              </div>
            </td>
          </tr>
        `).join("");

        renderPagination(locationsPaginationEl, locationsPage, totalPages, (page) => {
          locationsPage = page;
          renderLocations();
        });
      }

      function resetLocationForm() {
        locationForm.reset();
        locationForm.elements.id.value = "";
        resetLocationButton.setAttribute("hidden", "");
        setLocationMessage("");
      }

      async function loadLeads() {
        const data = await api("/api/admin/leads");
        allLeads = data.items || [];
        leadsPage = 1;
        renderLeads();
      }

      async function loadLocations() {
        const data = await api("/api/admin/locations");
        locations = data.items || [];
        locationsPage = 1;
        renderLocations();
      }

      // Tab 切换
      document.querySelectorAll(".admin-tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          const target = tab.dataset.tab;
          document.querySelectorAll(".admin-tab").forEach((el) => {
            el.classList.toggle("active", el === tab);
          });
          document.querySelectorAll(".tab-panel").forEach((panel) => {
            const match = panel.dataset.panel === target;
            if (match) panel.removeAttribute("hidden");
            else panel.setAttribute("hidden", "");
          });
        });
      });

      // 合作咨询搜索
      leadsSearch?.addEventListener("input", () => {
        leadsKeyword = leadsSearch.value;
        leadsPage = 1;
        renderLeads();
      });

      // 点位搜索（保留：原 input 监听重置分页）
      locationSearch?.addEventListener("input", () => {
        locationsPage = 1;
        renderLocations();
      });

      locationForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        setLocationMessage("");

        const formData = new FormData(locationForm);
        const id = formData.get("id");
        const payload = {
          id,
          city: formData.get("city"),
          spotName: formData.get("spotName"),
          sceneType: formData.get("sceneType"),
          deviceType: formData.get("deviceType"),
          status: formData.get("status"),
          description: formData.get("description"),
          keywords: formData.get("keywords")
        };
        const method = id === "" ? "POST" : "PUT";
        const data = await api("/api/admin/locations", {
          method,
          body: JSON.stringify(payload)
        });

        locations = data.items || [];
        setLocationMessage(data.message || "已保存");
        resetLocationForm();
        renderLocations();
      });

      locationsBody?.addEventListener("click", async (event) => {
        const editButton = event.target.closest("[data-edit]");
        const deleteButton = event.target.closest("[data-delete]");

        if (editButton) {
          const item = locations.find((entry) => String(entry.id) === editButton.dataset.edit);

          if (!item) return;

          locationForm.elements.id.value = item.id;
          locationForm.elements.city.value = item.city;
          locationForm.elements.spotName.value = item.spotName;
          locationForm.elements.sceneType.value = item.sceneType;
          locationForm.elements.deviceType.value = item.deviceType;
          locationForm.elements.status.value = item.status;
          locationForm.elements.description.value = item.description;
          locationForm.elements.keywords.value = item.keywords;
          resetLocationButton.removeAttribute("hidden");
          setLocationMessage(`正在修改：${item.spotName}`);
          locationForm.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        if (deleteButton) {
          const item = locations.find((entry) => String(entry.id) === deleteButton.dataset.delete);

          if (!item || !confirm(`确定删除「${item.spotName}」吗？`)) return;

          const data = await api("/api/admin/locations", {
            method: "DELETE",
            body: JSON.stringify({ id: item.id })
          });
          locations = data.items || [];
          setLocationMessage(data.message || "已删除");
          renderLocations();
        }
      });

      async function importLocations(mode) {
        const file = importFile.files?.[0];

        if (!file) {
          setLocationMessage("请先选择 CSV 文件", true);
          return;
        }

        if (mode === "replace" && !confirm("覆盖导入会替换当前全部点位，确定继续吗？")) {
          return;
        }

        try {
          setLocationMessage("正在导入 CSV...");
          const csvText = await readCsvImportFile(file);
          const data = await api("/api/admin/locations", {
            method: "PATCH",
            body: JSON.stringify({ mode, csvText })
          });
          locations = data.items || [];
          setLocationMessage(data.message || "导入完成");
          importFile.value = "";
          locationsPage = 1;
          renderLocations();
        } catch (error) {
          setLocationMessage(error.message || "导入失败，请检查 CSV 表头和内容", true);
        }
      }

      document.querySelector("#reset-location-form")?.addEventListener("click", resetLocationForm);
      document.querySelector("#append-import")?.addEventListener("click", () => importLocations("append"));
      document.querySelector("#replace-import")?.addEventListener("click", () => importLocations("replace"));
      document.querySelector("#logout-button")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        location.href = "/admin/login/";
      });

      Promise.all([loadLeads(), loadLocations()]).catch((error) => {
        setLocationMessage(error.message || "加载失败", true);
      });
    </script>
  </body>
</html>
