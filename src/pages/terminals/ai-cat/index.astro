---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import {
  aiCatAdvantages,
  aiCatCapabilities,
  aiCatFlow,
  aiCatGallery,
  aiCatHighlights,
  aiCatScenes
} from "../../../data/aiCat";
---

<BaseLayout
  title="AI机器猫"
  description="面向茶饮门店、商业快闪与品牌联名场景的 AI 引流机器人，支持主动迎宾、互动转化与会员沉淀。"
>
  <section class="cat-hero">
    <div class="shell cat-hero-grid">
      <div class="cat-hero-copy">
        <p class="eyebrow">AI LEAD ROBOT</p>
        <h1>AI机器猫引流机器人</h1>
        <p class="cat-lead">
          面向茶饮门店、商业快闪与品牌联名场景，提供主动迎宾、互动吸引、拍照发券与会员沉淀的一体化前场装置。
        </p>
        <div class="tag-list cat-hero-tags">
          <span class="tag">门店前场引流</span>
          <span class="tag">互动转化装置</span>
          <span class="tag">品牌联名场景</span>
          <span class="tag">会员沉淀入口</span>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/about/#contact">咨询项目合作</a>
          <a class="button button-secondary" href="#cat-scenes">查看适用场景</a>
        </div>
      </div>
      <div class="cat-hero-visual">
        <figure class="cat-hero-main">
          <img src="/assets/cat-bot/storefront-01.png" alt="AI机器猫适配茶饮门店场景" />
        </figure>
        <figure class="cat-hero-side cat-hero-side-top">
          <img src="/assets/cat-bot/mascot-hero.png" alt="AI机器猫角色形象" />
        </figure>
        <figure class="cat-hero-side cat-hero-side-bottom">
          <img src="/assets/cat-bot/social-scene.png" alt="年轻用户在门店互动拍照" />
        </figure>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="cat-stat-grid">
        {aiCatHighlights.map((item) => (
          <article class="cat-stat-card">
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionTitle
        eyebrow="PRODUCT VALUE"
        title="它不是摆件，而是门店前场的引流与互动入口"
        description="核心不是单点展示，而是把路过、停留、互动、转化串成完整链路。"
      />
      <div class="card-grid">
        {aiCatAdvantages.map((item) => (
          <article class="info-card cat-value-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell cat-flow-layout">
      <div>
        <SectionTitle
          eyebrow="CONVERSION FLOW"
          title="从识别到转化，形成前场闭环"
          description="识别、招呼、互动、发券只是起点，目标是把门口流量真正引进来、留下来。"
        />
        <div class="cat-flow-list">
          {aiCatFlow.map((item) => (
            <article class="cat-flow-item">
              <p class="cat-step">{item.step}</p>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="cat-flow-visual">
        <img src="/assets/cat-bot/postcard-terminal.png" alt="AI机器猫互动终端与明卡输出" />
      </div>
    </div>
  </section>

  <section class="page-section" id="cat-scenes">
    <div class="shell">
      <SectionTitle
        eyebrow="SCENARIOS"
        title="适合门店引流、联名快闪与品牌互动"
        description="更适合客流密集、年轻用户活跃、需要持续制造内容和话题的线下场景。"
      />
      <div class="cat-scene-grid">
        {aiCatScenes.map((item) => (
          <article class="cat-scene-card">
            <div class="cat-scene-media">
              <img src={item.imageSrc} alt={item.imageAlt} loading="lazy" />
            </div>
            <div class="cat-scene-copy">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell cat-capability-grid">
      <div class="cat-capability-panel">
        <p class="eyebrow">CAPABILITIES</p>
        <h2>支持角色、互动、内容与运营动作联动</h2>
        <div class="cat-capability-list">
          {aiCatCapabilities.map((item) => (
            <div class="cat-capability-item">
              <span></span>
              <p>{item}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="cat-gallery-grid">
        {aiCatGallery.map((item) => (
          <figure class="cat-gallery-item">
            <img src={item.src} alt={item.alt} loading="lazy" />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="cat-cta">
        <div>
          <p class="eyebrow">COOPERATION</p>
          <h2>适合需要引流、互动与品牌内容升级的门店与商业项目</h2>
          <p>支持方案沟通、场景适配、设备部署与项目交付。</p>
        </div>
        <a class="button button-primary" href="/about/#contact">立即咨询</a>
      </div>
    </div>
  </section>
</BaseLayout>
