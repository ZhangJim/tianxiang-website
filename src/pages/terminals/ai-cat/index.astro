---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import {
  aiCatAdvantages,
  aiCatCaseWall,
  aiCatFlow,
  aiCatHighlights,
  aiCatScenarioCards
} from "../../../data/aiCat";
---

<BaseLayout
  title="AI机器猫"
  description="面向茶饮门店、商业快闪与品牌联名场景的 AI 引流机器人，支持主动迎宾、互动吸引与会员沉淀。"
>
  <section class="cat-hero">
    <div class="shell cat-hero-grid">
      <div class="cat-hero-copy">
        <p class="eyebrow">AI LEAD ROBOT</p>
        <h1>AI机器猫引流机器人</h1>
        <p class="cat-lead">
          面向茶饮门店、商业快闪与品牌联名场景，提供主动迎宾、互动吸引、拍照发券与会员沉淀的一体化前场装置。
        </p>
        <div class="tag-list cat-hero-tags">
          <span class="tag">门前引流</span>
          <span class="tag">互动转化</span>
          <span class="tag">品牌联名</span>
          <span class="tag">会员沉淀</span>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/about/#contact">咨询项目合作</a>
          <a class="button button-secondary" href="#cat-scenarios">查看适配场景</a>
        </div>
      </div>
      <div class="cat-hero-visual">
        <figure class="cat-hero-main cat-hero-single">
          <img src="/assets/cat-bot/01.png" alt="AI机器猫门店引流场景" />
        </figure>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="cat-stat-grid">
        {aiCatHighlights.map((item) => (
          <article class="cat-stat-card">
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionTitle
        eyebrow="PRODUCT VALUE"
        title="它不是摆件，而是门店前场的引流与互动入口"
        description="核心不是单点展示，而是把路过、停留、互动、转化串成完整链路。"
      />
      <div class="card-grid">
        {aiCatAdvantages.map((item) => (
          <article class="info-card cat-value-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell cat-flow-layout">
      <div>
        <SectionTitle
          eyebrow="CONVERSION FLOW"
          title="从识别到转化，形成前场闭环"
          description="识别、招呼、互动、发券只是起点，目标是把门口流量真正引进来、留下来。"
        />
        <div class="cat-flow-list">
          {aiCatFlow.map((item) => (
            <article class="cat-flow-item">
              <p class="cat-step">{item.step}</p>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="cat-flow-visual">
        <img src="/assets/cat-bot/postcard-terminal.png" alt="AI机器猫互动终端与明信片输出" />
      </div>
    </div>
  </section>

  <section class="page-section" id="cat-scenes">
    <div class="shell">
      <SectionTitle
        eyebrow="CASE WALL"
        title="案例墙"
        description="展示 AI 机器猫在门店、商业空间与活动场景中的实际落地效果。"
      />
      <div class="cat-case-wall">
        {aiCatCaseWall.map((item, index) => (
          <figure class:list={["cat-case-item", index === 0 && "large", index === 4 && "wide"]}>
            <img src={item.src} alt={item.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section" id="cat-scenarios">
    <div class="shell">
      <SectionTitle
        eyebrow="SCENARIOS"
        title="适配场景"
        description="适合门店引流、品牌快闪、商业点位与年轻用户互动场景。"
      />
      <div class="cat-scenario-grid">
        {aiCatScenarioCards.map((item) => (
          <article class="info-card cat-scenario-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="cat-cta">
        <div>
          <p class="eyebrow">COOPERATION</p>
          <h2>适合需要引流、互动与品牌内容升级的门店与商业项目</h2>
          <p>支持方案沟通、场景适配、设备部署与项目交付。</p>
        </div>
        <a class="button button-primary" href="/about/#contact">立即咨询</a>
      </div>
    </div>
  </section>
</BaseLayout>
