---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import {
  travelPhotoCases,
  travelPhotoExperience,
  travelPhotoFeatures,
  travelPhotoGallery,
  travelPhotoStats,
  travelPhotoValues
} from "../../../data/travelPhoto";
---

<BaseLayout
  title="AI旅拍机"
  description="云裳一刻 AI旅拍机，以 AIGC 影像与在地文化叙事重构景区互动体验，适用于景区、文博、历史街区与城市地标场景。"
>
  <section class="travel-hero">
    <div class="shell travel-hero-grid">
      <div class="travel-hero-copy">
        <p class="eyebrow">YUNSHANGYIKE AI TRAVEL PHOTO</p>
        <h1>AI旅拍机</h1>
        <p class="travel-lead">
          通过AI拍照设备与内容生成能力，提升游客参与度与停留时间，带动现场消费与二次传播.
        </p>
        <div class="tag-list card-hero-tags">
          <span class="tag">中国风景名胜区协会推荐项目</span>
          <span class="tag">内容生成与传播能力</span>
          <span class="tag">现场消费转化能力</span>
          <span class="tag">文旅消费场景</span>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/about/#contact">咨询项目合作</a>
        </div>
      </div>
      <div class="travel-hero-visual">
        <img
          class="travel-hero-main"
          src="/assets/travel-photo/top1.png"
          alt="云裳一刻旅拍机景区落地案例"
        />
        
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="travel-stat-grid">
        {travelPhotoStats.map((item) => (
          <article class="travel-stat-card">
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionTitle
        eyebrow="BRAND VALUE"
        title="让景区更容易赚钱的内容与互动方案"
        description="从游客体验到内容传播，再到消费转化，形成完整的文旅运营闭环"
      />
      <div class="card-grid">
        {travelPhotoValues.map((item) => (
          <article class="info-card travel-value-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell travel-showcase-grid">
      <div>
        <SectionTitle
          eyebrow="CAPABILITY"
          title="核心能力不是拍照，而是内容与传播"
          description="围绕“好看、好发、能传播”，让每一次拍照都具备分享与消费价值"
        />
        <div class="travel-feature-list">
          {travelPhotoFeatures.map((item) => (
            <div class="travel-feature-item">
              <span></span>
              <p>{item}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="travel-poster-stack">
        <img src="/assets/travel-photo/nv.jpg" alt="天坛女" />
        <img src="/assets/travel-photo/nan.jpg" alt="天坛男" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionTitle
        eyebrow="EXPERIENCE FLOW"
        title="三步完成一次高质量打卡体验"
        description="流程简单、出片快速"
      />
      <div class="travel-flow-grid">
        {travelPhotoExperience.map((item) => (
          <article class="info-card travel-flow-card">
            {item.imageSrc && (
              <div class="travel-flow-visual">
                <img src={item.imageSrc} alt={item.imageAlt ?? item.title} loading="lazy" />
              </div>
            )}
            <div class="travel-flow-copy">
              <p class="travel-step">{item.step}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionTitle
        eyebrow="CASE WALL"
        title="案例墙"
        description="真实游客参与与持续运营效果，展示AI拍照设备在景区与商业场景中的落地转化能力"
      />
      <div class="travel-gallery">
        {travelPhotoGallery.map((item, index) => (
          <figure class:list={["travel-gallery-item", index % 3 === 0 && "wide", index === 6 && "tall"]}>
            <img src={item.src} alt={item.alt} loading="lazy" />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="section-title benchmark-title">
        <p class="eyebrow">BENCHMARK CASES</p>
        <h2>标杆案例，验证不同文旅场景的落地能力</h2>
        <p>覆盖景区、文博与历史街区等多类型场景，通过真实项目验证“内容 + 互动 + 转化”的一体化能力。</p>
      </div>
      <div class="location-search-card" data-location-search>
        <div>
          <h3>查询设备覆盖与投放机会</h3>
          <p>输入城市或景区名称，了解是否已有公开覆盖点位，或提交新的投放合作意向。</p>
        </div>
        <form class="location-search-form" data-location-search-form>
          <input
            type="search"
            name="keyword"
            placeholder="请输入城市或景区名称"
            autocomplete="off"
            data-location-search-input
          />
          <button class="button button-primary" type="submit">查询</button>
        </form>
        <div class="location-search-result" data-location-search-result hidden></div>
      </div>
      <div class="card-grid">
        {travelPhotoCases.map((item) => (
          <article class="info-card">
            <p class="card-meta">标杆案例</p>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="travel-cta">
        <div>
          <p class="eyebrow">COOPERATION</p>
          <h2>适合希望做出新体验、新传播和新增量的景区与文化地标</h2>
          <p>
            支持联合落地、内容定制、运营协同与长期服务。具体商务细节可沟通，但页面不公开敏感价格与过细设备参数。
          </p>
        </div>
        <a class="button button-primary" href="/about/#contact">预约沟通方案</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const searchRoot = document.querySelector("[data-location-search]");

  if (searchRoot) {
    const form = searchRoot.querySelector("[data-location-search-form]");
    const input = searchRoot.querySelector("[data-location-search-input]");
    const result = searchRoot.querySelector("[data-location-search-result]");
    let locations = [];

    const normalize = (value) => String(value ?? "").trim().toLowerCase();

    const parseCsvLine = (line) => {
      const cells = [];
      let current = "";
      let inQuotes = false;

      for (const char of line) {
        if (char === '"') {
          inQuotes = !inQuotes;
          continue;
        }

        if (char === "," && !inQuotes) {
          cells.push(current);
          current = "";
          continue;
        }

        current += char;
      }

      cells.push(current);
      return cells.map((cell) => cell.trim());
    };

    const parseCsv = (text) => {
      const lines = text
        .trim()
        .split(/\r?\n/)
        .filter(Boolean);
      const headers = parseCsvLine(lines.shift() ?? "");

      return lines.map((line) => {
        const cells = parseCsvLine(line);
        return headers.reduce((item, header, index) => {
          item[header] = cells[index] ?? "";
          return item;
        }, {});
      });
    };

    const renderCards = (items) => items
      .map((item) => `
        <article class="location-result-card">
          <p>${item["状态"]}</p>
          <h4>${item["点位名称"]}</h4>
          <div>
            <span>${item["城市"]}</span>
            <span>${item["场景类型"]}</span>
            <span>${item["设备类型"]}</span>
          </div>
          <small>${item["说明"]}</small>
        </article>
      `)
      .join("");

    const renderResult = (type, items = []) => {
      if (!result) return;

      const content = {
        covered: {
          title: "已查询到公开覆盖点位",
          desc: "该区域已有公开案例或设备覆盖，可继续咨询投放合作。"
        },
        related: {
          title: "找到相关覆盖点位",
          desc: "没有完全匹配的点位，但查询到相关城市或相近景区案例。"
        },
        empty: {
          title: "暂无公开覆盖点位",
          desc: "当前未查询到公开案例，可提交投放意向，我们会评估是否适合落地。"
        }
      }[type];

      result.hidden = false;
      result.innerHTML = `
        <div class="location-result-head">
          <div>
            <strong>${content.title}</strong>
            <p>${content.desc}</p>
          </div>
          ${type === "empty" ? '<a class="button button-secondary" href="/about/#contact">提交投放咨询</a>' : ""}
        </div>
        ${items.length ? `<div class="location-result-grid">${renderCards(items)}</div>` : ""}
      `;
    };

    fetch("/data/travel-photo-locations.csv")
      .then((response) => response.ok ? response.text() : "")
      .then((text) => {
        locations = text ? parseCsv(text) : [];
      })
      .catch(() => {
        locations = [];
      });

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const keyword = normalize(input?.value);

      if (!keyword) {
        renderResult("empty");
        return;
      }

      const exactMatches = locations.filter((item) => {
        const city = normalize(item["城市"]);
        const name = normalize(item["点位名称"]);
        return city === keyword || name === keyword;
      });

      if (exactMatches.length) {
        renderResult("covered", exactMatches);
        return;
      }

      const relatedMatches = locations.filter((item) => {
        const searchable = normalize(`${item["城市"]} ${item["点位名称"]} ${item["关键词"]}`);
        return searchable.includes(keyword) || keyword.includes(normalize(item["城市"]));
      });

      if (relatedMatches.length) {
        renderResult("related", relatedMatches.slice(0, 6));
        return;
      }

      renderResult("empty");
    });
  }
</script>
