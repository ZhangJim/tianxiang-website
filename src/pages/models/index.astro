---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import ComputeTabs from "../../components/ComputeTabs.astro";
import {
  modelAccessModes,
  modelCategories,
  modelEcosystemProviders,
  modelMarketHighlights,
  models
} from "../../data/compute";
---

<BaseLayout title="模型市场">
  <section class="page-section">
    <div class="shell">
      <ComputeTabs />
      <SectionTitle
        eyebrow="MODEL MARKET"
        title="整合主流大模型能力，提供可落地的行业应用方案"
        description="支持多模型接入与能力组合，结合实际业务场景，完成从模型调用到产品落地的整体交付。"
      />

      

      <div class="tag-list" style="margin-top: 20px; margin-bottom: 10px;">
        {modelEcosystemProviders.map((item) => <span class="tag">{item}</span>)}
      </div>

      <p class="model-market-note">
        重点覆盖企业最常咨询的对话、推理、视觉、多模态与行业模型，
        同时保留 API 聚合接入、企业生产接入和私有化部署三种交付路径。
      </p>
    </div>
  </section>
  <section class="page-section">
    <div class="shell">
      <SectionTitle
        eyebrow="MODEL MATRIX"
        title="支持对接主流模型能力，具体方案根据项目需求定制"
        description="不仅展示模型能力，更明确接入方式、应用场景与交付路径，支持企业从能力选择到项目落地。"
      />
      <div class="tag-list" style="margin-bottom: 18px;">
        {modelCategories.map((item) => <span class="tag">{item}</span>)}
      </div>
      <div class="card-grid">
        {models.map((model) => (
          <article class="info-card model-card">
            <p class="card-meta">{model.category}</p>
            <h3>{model.name}</h3>
            <p class="model-provider">{model.provider}</p>
            <p class="model-version">{model.version}</p>
            <div class="tag-list model-card-tags">
              <span class="tag">{model.status}</span>
              <span class="tag">{model.delivery}</span>
              {model.tags.map((item) => <span class="tag">{item}</span>)}
            </div>
            <p class="model-copy">{model.capability}</p>
            <p>适用场景：{model.scenario}</p>
            <a href="/about/#contact">咨询接入</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
