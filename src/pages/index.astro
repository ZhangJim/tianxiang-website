---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechCapabilities from "../components/TechCapabilities.astro";

const heroScene = {
  src: "/assets/topshouye.png",
  alt: "AI 终端在文旅与商业场景中的落地展示"
};

const productCards = [
  {
    title: "AI旅拍机",
    description: "面向景区与文旅项目的 AI 拍照与内容生成设备。",
    href: "/terminals/travel-photo/",
    image: "/assets/travel-photo/biz-019.png",
    alt: "AI旅拍机设备"
  },
  {
    title: "AI潮玩卡牌机",
    description: "面向商场与商业空间的 AI 互动终端与数字内容入口。",
    href: "/terminals/card-machine/",
    image: "/assets/card-machine/222.jpg",
    alt: "AI潮玩卡牌机"
  },
  {
    title: "景区场景",
    description: "支持游客互动、打卡传播与文旅内容延展。",
    href: "/terminals/travel-photo/",
    image: "/assets/travel-photo/biz-014.jpeg",
    alt: "景区游客体验场景"
  },
  {
    title: "商业空间",
    description: "支持商场引流、互动体验与年轻化内容消费。",
    href: "/terminals/card-machine/",
    image: "/assets/card-machine/product-007.jpeg",
    alt: "商场互动场景"
  }
];

const capabilities = [
  {
    title: "算力资源",
    description: "提供 GPU 算力资源调度与交付支持，覆盖训练、推理与项目部署。"
  },
  {
    title: "模型接入",
    description: "支持主流模型 API 接入与私有化部署，适配企业应用与场景需求。"
  },
  {
    title: "项目交付",
    description: "从方案设计、系统接入到设备部署与现场落地，支持完整项目实施。"
  }
];

const stats = [
  { value: "300+", label: "景区合作" },
  { value: "50+", label: "商业体落地" },
  { value: "1200+", label: "设备长期运营" }
];

const partners = [
  { src: "/assets/card-machine/home/nvidia.2b41e636.png", alt: "NVIDIA" },
  { src: "/assets/card-machine/home/kexueyuan.63ebfd1d.png", alt: "中国科学院" },
  { src: "/assets/card-machine/home/zidonghua.979f978b.png", alt: "自动化研究机构" },
  { src: "/assets/card-machine/home/youdian.d134f0b6.png", alt: "北京邮电大学" },
  { src: "/assets/card-machine/home/hangtian.4b952218.png", alt: "航天信息" },
  { src: "/assets/card-machine/home/dizhenju.17be2e48.png", alt: "中国地震局工程力学研究所" }
];
---

<BaseLayout title="首页">
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">XCASTLE AI</p>
        <h2>让 AI 能力真正进入线下场景，并持续产生价值</h2>
        <p class="hero-copy">
          覆盖文旅、商业与互动消费空间，提供 AI 终端、模型能力与场景运营支持。
        </p>
      </div>

      <div class="home-hero-visual">
        <figure class="hero-scene hero-scene-main">
          <img src={heroScene.src} alt={heroScene.alt} />
        </figure>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="section-title compact-title">
        <p class="eyebrow">PRODUCTS & SCENARIOS</p>
        <h2>核心产品与场景</h2>
      </div>

      <div class="home-product-grid">
        {productCards.map((item) => (
          <article class="home-product-card">
            <div class="home-product-media">
              <img src={item.image} alt={item.alt} loading="lazy" />
            </div>
            <div class="home-product-copy">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a href={item.href}>查看详情</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <TechCapabilities />

  <section class="page-section">
    <div class="shell">
      <div class="section-title compact-title">
        <p class="eyebrow">AI SERVICES</p>
        <h2>AI能力与服务</h2>
      </div>

      <div class="card-grid">
        {capabilities.map((item) => (
          <article class="info-card service-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="section-title compact-title">
        <p class="eyebrow">FOOTPRINT</p>
        <h2>真实落地规模与运营结果</h2>
      </div>

      <div class="home-stat-grid">
        {stats.map((item) => (
          <article class="home-stat-card">
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/*
  <section class="page-section">
    <div class="shell">
      <div class="section-title compact-title">
        <p class="eyebrow">PARTNERS</p>
        <h2>合作伙伴</h2>
      </div>

      <div class="partner-wall">
        {partners.map((item) => (
          <div class="partner-card">
            <img src={item.src} alt={item.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>
  */}
</BaseLayout>
